{
  "services": {
    "my_frontend": {
      "root": "frontend/",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "my_backend": {
      "root": "api/",
      "entrypoint": "app:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "my_backend" } },
    { "source": "/(.*)", "destination": { "service": "my_frontend" } }
  ]
}